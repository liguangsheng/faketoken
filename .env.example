# Copy to .env and fill in the secrets.
#   openssl rand -hex 32   -> JWT_SECRET
#   openssl rand -hex 32   -> ENCRYPTION_KEY   (rotating this invalidates stored channel keys)

# ---- secrets (required) -------------------------------------------------
JWT_SECRET=
ENCRYPTION_KEY=

# ---- database -----------------------------------------------------------
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=llmproxy
POSTGRES_DB=llmproxy
POSTGRES_PORT=5433
# The integration suite runs against a separate throwaway instance on this
# port (docker compose profile "test"), never against the database above.
TEST_POSTGRES_PORT=5434
# Used when running the binary outside docker-compose:
DATABASE_URL=postgres://llmproxy:llmproxy@localhost:5433/llmproxy?sslmode=disable

# ---- server -------------------------------------------------------------
# LISTEN is the address inside the container / process.
# SERVER_PORT is the host port docker-compose publishes it on.
LISTEN=:3200
SERVER_PORT=3200
WEB_DIR=web/dist

# ---- bootstrap ----------------------------------------------------------
INIT_ADMIN_USER=admin
INIT_ADMIN_PASS=admin123
ALLOW_REGISTER=true
# Balance granted to newly registered users, in micro-USD (1000000 = $1)
INIT_QUOTA_MICRO_USD=1000000

# ---- billing ------------------------------------------------------------
# What to do with a model that has no row in the price table.
#   reject   – refuse the request (default; nothing is relayed unbilled)
#   fallback – relay it and bill at the BILLING_FALLBACK_* rates below
#   free     – relay it and charge nothing (records usage only)
# Administrators can override this at runtime from the console.
BILLING_UNPRICED_POLICY=reject
# Only used by the fallback policy. USD per 1M tokens, except the last one
# which is USD per request. At least one must be non-zero.
BILLING_FALLBACK_INPUT_PRICE=0
BILLING_FALLBACK_OUTPUT_PRICE=0
BILLING_FALLBACK_CACHED_PRICE=0
BILLING_FALLBACK_PER_REQUEST_PRICE=0
# Where the console pulls model prices from. Leave blank to disable the import
# entirely, which is what a deployment without egress wants; point it at a
# mirror to avoid the public endpoint.
MODELS_DEV_URL=https://models.dev/api.json

# ---- domain verification ------------------------------------------------
# Served verbatim at /.well-known/ara-claim.txt. Leave blank to keep the claim
# compiled into the binary; set it to rotate without a rebuild.
ARA_CLAIM=

# ---- backups ------------------------------------------------------------
# Nightly pg_dump of POSTGRES_DB, taken at BACKUP_AT in the TZ below (not UTC).
# Dumps land in BACKUP_DIR on the host, owned by BACKUP_UID:BACKUP_GID so they
# stay readable from outside the container. Only the newest BACKUP_KEEP are
# kept. BACKUP_EXCLUDE_DATA lists tables dumped as schema only — their rows are
# skipped, which is what keeps the raw request bodies out of every backup.
TZ=Asia/Singapore
BACKUP_DIR=./.backup
BACKUP_AT=05:00
BACKUP_KEEP=10
BACKUP_EXCLUDE_DATA=request_log_details
BACKUP_UID=1000
BACKUP_GID=1000

# ---- relay tuning -------------------------------------------------------
RELAY_TIMEOUT=10m
STREAM_IDLE_TIMEOUT=120s
MAX_RETRIES=3
SESSION_TTL=168h
